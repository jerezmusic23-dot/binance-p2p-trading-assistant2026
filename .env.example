# Variables de entorno del proyecto.
#
# NOMBRES UNICAMENTE. Este fichero se versiona; los valores reales NO.
# Copiar a .env (ignorado por git) o definirlos en el panel de Northflank.
# Nunca escribir un token real aqui.

# ---------------------------------------------------------------------------
# PERSISTENCIA
# ---------------------------------------------------------------------------
# Directorio donde se escribe market_history.json.
# Debe apuntar al volumen persistente montado; sin el, el historico se pierde
# en cada redeploy. Si no se define, se usa ./data dentro del contenedor.
DATA_DIR=

# Tamano de la ventana activa del historico, en registros.
# Por defecto 43200 = 30 dias a un registro por minuto.
#
# Cada escritura reescribe el fichero entero, asi que el coste crece con el
# numero de registros. Al superar el limite, los mas antiguos se MUEVEN a
# data/history_archive/ - nunca se borran.
#
# 0 desactiva el archivado y restaura el comportamiento sin limite.
HISTORY_MAX_RECORDS=

# ---------------------------------------------------------------------------
# TELEGRAM (opcional)
# ---------------------------------------------------------------------------
# Sin ambas variables el notificador arranca DESACTIVADO y en silencio.
# Eso no es un error: es el estado por defecto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Milisegundos entre dos mensajes de la misma alerta. Opcional.
# Por defecto 300000 (5 min). Las alertas de sistema aplican ademas un suelo
# propio de 900000 (15 min) sobre este valor.
TELEGRAM_ALERT_COOLDOWN_MS=

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
PORT=
HOST=
